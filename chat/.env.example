# Required: NVIDIA API Catalog key (https://build.nvidia.com/).
NVIDIA_API_KEY=nvapi-...

# URL of the nyaya MCP server the agent calls for retrieval.
# Same-process deploy: http://localhost:8000/mcp
# Production:          https://nyaya.parag.tech/mcp
NYAYA_MCP_URL=http://localhost:8000/mcp

# LLM tuning.
# CHAT_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# CHAT_LLM_TEMPERATURE=0.1
# CHAT_LLM_MAX_TOKENS=2048
# CHAT_LLM_TIMEOUT_S=60

# Message constraints.
# CHAT_MAX_MESSAGE_CHARS=4000
# CHAT_MAX_HISTORY=8

# Optional: comma-separated MCP tool allowlist. Empty/unset exposes the
# curated default set (hybrid_search, search_law, get_section, get_article,
# get_judgment, cross_reference, resolve_citation, list_acts, corpus_stats).
# CHAT_TOOLS=hybrid_search,get_section,get_article,get_judgment

# Chat rate limit is owned by the host server; set via NYAYA_RATE_CHAT_PER_MIN
# (default 15) in the repo-root .env.example.

# Log level (DEBUG, INFO, WARNING, ERROR).
# NYAYA_CHAT_LOG_LEVEL=INFO
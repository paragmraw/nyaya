# committed snapshot that useCorpusStats() uses as its SWR fallbackData.
/public/corpus-stats.json

# Generated by `next dev` (agent-guidance files it re-writes on every run —
# see node_modules/next/dist/server/lib/generate-agent-files.js).
/AGENTS.md
/CLAUDE.md

# Playwright MCP session artifacts (local only).
/.playwright-mcp/
# The Docker build context is the repo root. The root Dockerfile builds two
# stages: web/ (Node SPA) and mcp/ (Python server). We exclude everything
# else, plus the build artifacts that should not enter the image.

# --- Version control / CI ---
.git
.github

# --- Python caches / build artifacts (anywhere in the repo) ---
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/htmlcov
**/.coverage
**/.coverage.*
**/coverage.xml
**/dist
**/build
**/*.egg-info
**/.eggs

# --- Virtualenvs ---
.venv
**/.venv
**/venv

# --- Secrets ---
.env
.env.local
.env.*.local
mcp/.env
mcp/.env.local

# --- Test / notebook files (not needed in the runtime image) ---
mcp/tests
mcp/notebooks

# --- Large / transient data (keep manual YAML, ignore raw dumps + caches) ---
mcp/data/raw
mcp/data/hf_cache
mcp/data/cache

# --- Frontend build artifacts (rebuilt inside the image) ---
web/node_modules
web/.next
web/out
web/.git

# --- Other languages / OS ---
node_modules
**/node_modules
.DS_Store
Thumbs.db
*.log
docs/_build/

# --- Scratch design files (gitignored anyway, never in the image) ---
scratch
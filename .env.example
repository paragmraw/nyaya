# Required: Postgres / Supabase connection string.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:6543/postgres

# Required by the chat backend (chat/): NVIDIA API Catalog key for Nemotron.
# Get one at https://build.nvidia.com/. The chat service reads this to call
# nvidia/nemotron-3.5-lightning-30b-a3b via langchain-nvidia-ai-endpoints.
NVIDIA_API_KEY=nvapi-...

# Optional: enable the frontend chat panel (default: false).
# Set to "true" to enable the chat panel. This is a Next.js build-time flag,
# so it must be set before `npm run build` (or via the Dockerfile ARG).
# NEXT_PUBLIC_CHAT_ENABLED=false

# Optional: HTTP port for the uvicorn server (default 8000; Railway sets
# this automatically).
# PORT=8000
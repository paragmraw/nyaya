# Required: Postgres / Supabase connection string.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:6543/postgres

# Required by the MCP server (embedding + reranking via the NVIDIA API) AND the
# chat backend (chat/). Get one at https://build.nvidia.com/.
NVIDIA_API_KEY=nvapi-...

# Optional: enable the frontend chat panel (default: false).
# Set to "true" to enable the chat panel. This is a Next.js build-time flag,
# so it must be set before `npm run build` (or via the Dockerfile ARG).
# NEXT_PUBLIC_CHAT_ENABLED=false

# Optional: HTTP port for the uvicorn server (default 8000; Railway sets
# this automatically).
# PORT=8000

# Optional: Redis connection string for distributed rate limiting across
# multiple workers. When unset, in-memory rate limiting is used (single
# worker only). Set this for multi-worker deployments.
# REDIS_URL=redis://localhost:6379

# Optional: Langfuse tracing for LLM observability. When all three are set,
# every supervisor/synthesis call is traced with input/output/tokens/latency.
# Get keys at https://langfuse.com (cloud or self-hosted).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
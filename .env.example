# Required: Postgres / Supabase connection string.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:6543/postgres

# Optional: HTTP port for the uvicorn server (default 8000; Railway sets this).
# PORT=8000

# Optional: Connection-pool sizing for the read layer.
# NYAYA_POOL_MIN=1
# NYAYA_POOL_MAX=8
# NYAYA_POOL_TIMEOUT=3.0

# Optional: Postgres statement_timeout in ms (0 = off). Protects against slow
# ts_headline calls over very large judgment text. Default: 15000 (15s).
# NYAYA_STATEMENT_TIMEOUT=15000

# Optional: Root log level (DEBUG, INFO, WARNING, ERROR).
# NYAYA_LOG_LEVEL=INFO

# Optional: Override the fastembed model (must produce 1024-d vectors).
# NYAYA_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Optional: Chat turn rate limit (requests per minute per IP). Each chat turn
# triggers one or more NVIDIA LLM calls plus several MCP round-trips, so this
# is much tighter than the read limit. Default: 15.
# NYAYA_RATE_CHAT_PER_MIN=15

# Optional: Redis connection string for distributed rate limiting. When set,
# rate-limit counters are shared across all workers for strict global limits.
# When unset, rate limiting falls back to in-memory (single-worker only).
# REDIS_URL=redis://localhost:6379/0

# Required by the chat backend (chat/): NVIDIA API Catalog key for Nemotron.
# Get one at https://build.nvidia.com/. The chat service reads this to call
# nvidia/nemotron-3-ultra-550b-a55b via langchain-nvidia-ai-endpoints.
NVIDIA_API_KEY=nvapi-...

# Optional: URL the chat backend uses to reach the nyaya MCP server.
# Local dev:      http://localhost:8000/mcp
# Docker compose: http://nyaya:8000/mcp (set automatically in docker-compose.yml)
# Production:     https://nyaya.parag.tech/mcp
# NYAYA_MCP_URL=http://localhost:8000/mcp
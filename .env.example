# Nyaya MCP v2.1: Environment Configuration (Database-Free Embedded + Object Storage)
# Copy to .env for local development. MCP core runs with ZERO required secrets!

# --- 1. MCP Local Core (no secrets required) ---------------------------------
# Directory containing baked/downloaded nyaya-core.sqlite (and optional local packs).
# Defaults to /app/data in container, else $XDG_CACHE_HOME/nyaya/data (or ~/.cache/nyaya/data).
# NYAYA_DATA_DIR=

# Directory for 256 MiB PDF zstd LRU cache + DuckDB temp spill (must be disk-backed
# on Linux Docker, e.g. /var/cache/nyaya named volume; /tmp/nyaya-cache on Railway).
# NYAYA_CACHE_DIR=

# Set to "true" or "1" to globally exclude CC-BY-NC datasets (DDL 81M District
# Courts, ILDC) across SQLite, LanceDB, DuckDB, MCP tools, and REST endpoints.
# NYAYA_COMMERCIAL_SAFE_ONLY=false

# Directory holding the pre-installed DuckDB httpfs extension (set to /app/duckdb_ext
# in the Docker image; leave unset locally).
# NYAYA_DUCKDB_EXT_DIR=

# Log level for the server (default INFO).
# NYAYA_LOG_LEVEL=INFO

# Set to "true" or "1" for air-gapped local stdio (disables Bucket/S3/manifest network fetches).
# NYAYA_OFFLINE_ONLY=false

# Public manifest.json URL for anonymous `nyaya-mcp sync` / startup pack downloads.
# NYAYA_MANIFEST_URL=

# Opt-in flag so `get_settings()` loads a local .env file (requires `dotenv` extra).
# NYAYA_DOTENV=1

# --- 2. Optional v2.1 OCR, Hybrid Search & Live Docket (Disabled by Default) -
# Opt-in Apache-2.0 OCR fallback for scanned pre-2010 PDFs (requires tesseract CLI
# or rapidocr_onnxruntime; disabled by default).
# NYAYA_ENABLE_OCR=false

# Opt-in hybrid BM25 + vector Reciprocal Rank Fusion (RRF) retrieval. When true
# with no NYAYA_EMBEDDING_ENDPOINT, uses zero-dependency HashedNgramEmbeddingProvider.
# NYAYA_HYBRID_SEARCH=false

# Optional OpenAI-compatible `/embeddings` HTTP endpoint & model (used only when
# NYAYA_HYBRID_SEARCH=true; zero API keys or endpoints required by default).
# NYAYA_EMBEDDING_ENDPOINT=
# NYAYA_EMBEDDING_MODEL=

# Optional BYO official/licensed live docket & cause-list adapter for
# `get_cause_list(live=True)` (also accepts NYAYA_LIVE_DOCKET_URL fallback).
# NYAYA_LIVE_DOCKET_API_URL=
# NYAYA_LIVE_DOCKET_API_KEY=

# --- 3. Railway Storage Bucket / S3 Cold Tiers (Optional) ------------------
# Private S3-compatible bucket (Tigris / Railway Storage Bucket) holding LanceDB
# BM25 FTS tables and compacted ZSTD Parquet partitions. Leave blank for SQLite-only
# or local manifest mode.
# NYAYA_BUCKET_ENDPOINT=https://storage.railway.app
# NYAYA_BUCKET_NAME=
# NYAYA_BUCKET_ACCESS_KEY_ID=
# NYAYA_BUCKET_SECRET_ACCESS_KEY=
# NYAYA_BUCKET_REGION=auto
# Use "vhost" for Railway/Tigris S3, "path" for local MinIO.
# NYAYA_BUCKET_URL_STYLE=vhost

# --- 4. Chat Sub-App (Optional: /chat mounts only when NVIDIA_API_KEY is set)
# Get a key at https://build.nvidia.com/. Not required for MCP tools or REST API.
# NVIDIA_API_KEY=nvapi-...

# Next.js static export build-time flag (embedded during `npm run build`).
# NEXT_PUBLIC_CHAT_ENABLED=true

# --- 5. HTTP Operations, Proxy & Observability (Optional) --------------------
# HTTP port for uvicorn (default 8000; Railway injects PORT automatically).
# PORT=8000

# Right-most trusted proxy hops for X-Forwarded-For / X-Forwarded-Proto
# (default 1 behind Railway edge; set 0 when exposed directly without a proxy).
# NYAYA_TRUSTED_PROXY_HOPS=1

# Optional Redis URL for distributed rate limiting across multiple workers.
# REDIS_URL=redis://localhost:6379

# Optional Langfuse tracing for chat/nyaya_chat LLM observability.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- 6. Ingestion & Publishing (offline nyaya-ingest CLI only) ---------------
# GitHub token (with the `gh` CLI installed) for `nyaya-ingest publish --target gh-release`.
# GITHUB_TOKEN=

# --- 7. Docker build-time corpus bake (Dockerfile Stage 2b / Railway Variables) -
# Verified release URL (.zst) + SHA-256 of nyaya-core.sqlite.zst baked into the
# image; both must be set together. Empty = offline mini_corpus fixture (CI).
# NYAYA_CORE_SQLITE_URL=
# NYAYA_CORE_SQLITE_SHA256=
